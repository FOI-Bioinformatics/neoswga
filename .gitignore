# Project-specific
# Large test output directories (regenerated as needed)
neoswga_results/

# Benchmark outputs (regenerated)
benchmarks/benchmark_results.csv
benchmarks/checkpoint.json

# H5 position files (large, regenerated)
*.h5

# Jellyfish k-mer database files (large, regenerated)
*.jf

# Coverage reports (regenerated)
htmlcov/
.coverage

# Jellyfish k-mer files (large, regenerated)
*_*mer_all.txt

# Pipeline output files (keep in results directories only)
step*_output.txt
step*_debug*.txt

# Temporary conda error logs
h5py

# Validation test results (regenerated)
validation_tests/results/

# ML model files (large, can be retrained with scripts/retrain_rf_model.py)
# neoswga/core/models/*.p  # Tracked: required for score step

# Large genome files in test data (download separately)
tests/integration/**/human_*.fna
tests/integration/**/human_*.fasta

# Integration test output data (regenerated)
tests/integration/**/data/

# Integration test working directories (local experiments)
tests/integration/equiphi29_long/
tests/integration/equiphi29_validation/
tests/integration/equiphi29_full_factorial/

# Test data H5 files (large, regenerated)
test_data/*.h5

# Example generated files (run examples locally)
examples/**/kmer_files/
examples/**/step*.csv
examples/**/step*.json
examples/**/*.h5
examples/**/report.html
examples/**/*.bedgraph
examples/**/*_all.txt
# The sidecar records the genome a k-mer table was counted from. The table it
# describes is ignored on the line above, so committing the sidecar would ship a
# provenance record for a file that is not in the repository.
examples/**/*_all.provenance.json
examples/**/export/
examples/**/params_backup.json
examples/**/run_manifest.json
examples/**/filter_stats.json
# The durable candidate inventory. A pipeline artifact like the rest of this
# section, and a large one: 181 MB on the Wolbachia design, over GitHub's
# 100 MB file limit.
examples/**/candidate_inventory.sqlite
examples/**/genome_gc.json
examples/**/*technical_report.html
examples/ecoli_environmental/ecoli_K12_MG1655.fasta

# Diagnostic written only when the suite has failures; see
# tests/test_failure_context_is_recorded.py.
.pytest_failure_context.json

# Root-level pipeline run artifacts used to be ignored here. They are not any
# more: a run that writes into the repository root is a defect, and hiding the
# file left the defect in place. tests/test_the_suite_leaves_no_files_behind.py
# fails if one reappears.

# Local planning/spec scratch (not part of the package)
docs/superpowers/

# Per-machine Claude Code permission allowlist -- not shared project config.
# Project-level skills under .claude/skills/ ARE tracked and are not matched
# by this pattern.
.claude/settings.local.json

# Git worktrees
.worktrees/

# Reference genomes for the specificity validation. Fetched on request by
# scripts/fetch_reference_genomes.py; the smallest useful pair is ~50 Mb and
# the full human background is 3 Gb, so they are not committed.
tests/validation/genomes/

# local experiment runs
runs/
